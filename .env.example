# Production / dev server
JWT_SECRET=change-this-to-a-long-random-string
PORT=3080
APP_URL=http://localhost:3080
CORS_ORIGIN=*

# Email (console logs links in dev)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=sendgrid
# RESEND_API_KEY=re_xxxx
# SENDGRID_API_KEY=SG.xxxx
# EMAIL_FROM=Inkling <notifications@yourdomain.com>

# AI — powers the Inkling chat assistant AND WordWeaver remarks (OpenAI-compatible).
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
# Set OPENAI_API_KEY here (copy this file to .env) for a real conversational AI;
# without it, Inkling falls back to the built-in templated responses.
# LLM_PROVIDER=openai
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
