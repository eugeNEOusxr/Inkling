# Production / dev server
JWT_SECRET=change-this-to-a-long-random-string
PORT=3080
APP_URL=http://localhost:3080
CORS_ORIGIN=*

# Email (console logs links in dev)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=sendgrid
# RESEND_API_KEY=re_xxxx
# SENDGRID_API_KEY=SG.xxxx
# EMAIL_FROM=Inkling <notifications@yourdomain.com>

# Mind graph — Claude Haiku concept extraction (Stage 2b). SET THIS IN THE RENDER
# DASHBOARD (Environment tab), never in a committed file. Without it the Mind falls
# back to the local lexicon and /api/inkling/extract returns {source:"none"}.
# ANTHROPIC_API_KEY=sk-ant-...
# MIND_EXTRACT_MODEL=claude-haiku-4-5   # optional extraction model override
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6  # optional chat model (haiku=cheaper, opus=best)
# Cost protection: AI chat + extraction require sign-in; per-user daily caps:
# AI_DAILY_CHAT_CAP=120
# AI_DAILY_EXTRACT_CAP=300

# AI — powers the Inkling chat assistant AND WordWeaver remarks (OpenAI-compatible).
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
# Set OPENAI_API_KEY here (copy this file to .env) for a real conversational AI;
# without it, Inkling falls back to the built-in templated responses.
# LLM_PROVIDER=openai
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
